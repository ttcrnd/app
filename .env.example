# Copy to .env and fill secrets for local development.
# The server and run_all.py read these variables automatically.

# GitHub access token (recommended for API limits and security endpoints)
GITHUB_TOKEN=

# Alternative token variable supported by the project
# GH_TOKEN=

# Pilot access (krok 5 / D8). Empty code = open local mode (no gate).
# One shared code, or comma-separated list for 2–3 pilot accounts.
PILOT_ACCESS_CODE=
# PILOT_ACCESS_CODES=alpha,bravo,charlie
# PILOT_CODE_ENABLED=true
# PILOT_SESSION_SECRET=
# Behind HTTPS set true so session cookie is Secure (krok 10).
# PILOT_COOKIE_SECURE=true

# Full roles (krok 13 / D11 + D15). Password login + user admin.
# USER_AUTH_ENABLED=false
# With USER_AUTH_ENABLED=true the shared code becomes emergency bootstrap admin.
# Optional bootstrap admin (created on startup if missing):
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# To run only with accounts (no shared code): USER_AUTH_ENABLED=true and PILOT_CODE_ENABLED=false

# AI note assist (krok 11 / D12). Default OFF — app runs without keys.
# AI_ENABLED=false
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# AI_RATE_LIMIT_PER_MIN=10

# Ed25519 signing (krok 12 / D14). Auto-generates data/signing/ if unset.
# SIGNING_PRIVATE_KEY_PEM=
# SIGNING_KEY_PATH=

# Seed demo/pilot libraries + evaluations on startup (default: off).
# REVIEW_SEED_PILOT=true

# Public demo URL (documentation / Caddy); not required for local make dev.
# PUBLIC_BASE_URL=https://demo.example.org
# PUBLIC_HOST=demo.example.org
# REVIEW_PUBLISH_PORT=8000

# Persistence (krok 7). Default SQLite file data/review.db if unset.
# Postgres later: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=sqlite:///./data/review.db
# Docker prod: sqlite:////data/review.db

# FastAPI server runtime
REVIEW_SERVICE_HOST=127.0.0.1
REVIEW_SERVICE_PORT=8000
REVIEW_SERVER_RELOAD=true
REVIEW_LOG_LEVEL=INFO
